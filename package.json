{
  "name": "spectrum-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:wasm": "bash scripts/build-wasm.sh",
    "test:wasm": "bash scripts/test-wasm.sh",
    "test:browser": "node scripts/browser-check.mjs",
    "test:browser:multiplex": "node scripts/browser-multiplex-check.mjs",
    "test:browser:wwv": "node scripts/browser-wwv-check.mjs",
    "test:browser:am": "node scripts/browser-am-check.mjs",
    "test:browser:nfm": "node scripts/browser-nfm-check.mjs",
    "test:browser:armer": "node scripts/browser-armer-check.mjs",
    "test:fieldglass": "node scripts/compare-fieldglass.mjs",
    "test:usb": "node scripts/browser-usb-check.mjs",
    "check": "npm test && npm run test:api && npm run test:wasm && npm run build",
    "test:browser:ook": "node scripts/browser-ook-check.mjs",
    "test:browser:recording": "node scripts/browser-recording-check.mjs",
    "build:rtl433": "bash scripts/build-rtl433.sh",
    "test:rtl433": "node scripts/check-rtl433.mjs",
    "test:browser:rtl433": "node scripts/browser-rtl433-check.mjs",
    "test:browser:armer-auto-center": "node scripts/browser-armer-auto-center-check.mjs",
    "test:browser:modules": "node scripts/browser-modules-check.mjs",
    "app": "npm run build && vite preview --port 5177",
    "test:browser:pwa": "node scripts/browser-pwa-check.mjs",
    "api": "cd backend && go run .",
    "test:api": "cd backend && go test ./..."
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@jtarrio/webrtlsdr": "3.0.7",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-web-usb": "1.0.14",
    "@vitejs/plugin-react": "6.3.0",
    "@xmldom/xmldom": "0.9.12",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.6"
    }
  }
}
