{
  "name": "spectrum-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:wasm": "bash scripts/build-wasm.sh",
    "test:wasm": "bash scripts/test-wasm.sh",
    "test:browser": "node scripts/browser-check.mjs",
    "test:browser:wwv": "node scripts/browser-wwv-check.mjs",
    "test:browser:am": "node scripts/browser-am-check.mjs",
    "test:browser:nfm": "node scripts/browser-nfm-check.mjs",
    "test:browser:armer": "node scripts/browser-armer-check.mjs",
    "test:fieldglass": "node scripts/compare-fieldglass.mjs",
    "test:usb": "node scripts/browser-usb-check.mjs",
    "check": "npm test && npm run test:wasm && npm run build",
    "test:browser:ook": "node scripts/browser-ook-check.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@jtarrio/webrtlsdr": "3.0.7",
    "@xmldom/xmldom": "^0.9.12",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-web-usb": "1.0.14",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
